# MongoDB connection string (local or MongoDB Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/website-reliability

# Express API port.
PORT=4000

# Bootstrap the first Admin account. Choose a username not already registered.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional SMTP settings for incident and recovery email notifications.
# For Gmail, enable 2-Step Verification and use a Google App Password (not your account password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM=your-account@gmail.com
# Optional extra recipients for all alerts (Admins and assigned Users are configured in the app).
# ALERT_EMAIL=recipient@gmail.com,team@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL=

# Optional AI incident analysis via Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
